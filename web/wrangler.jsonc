// Cloudflare Workers（靜態網站）設定：只上傳 npm run build 產生的 dist/，沒有後端程式。
// name 必須和 Cloudflare 後台的 Worker 名稱相同。
{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "taipei-trash-can",
  "compatibility_date": "2026-10-01",
  // 明確開啟 workers.dev 網址與分支預覽網址（兩者都受 Cloudflare Access 保護）
  "workers_dev": true,
  "preview_urls": true,
  // 非 main 分支的 build 用 `npx wrangler preview` 產生預覽，這個指令需要 previews 區塊（可以是空的）
  "previews": {},
  "assets": {
    "directory": "./dist"
  }
}
